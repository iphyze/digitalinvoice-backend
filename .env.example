APP_ENV=local
APP_NAME="DigitalInvoice Nigeria"
APP_URL=http://localhost/digitalinvoice-server
FRONTEND_URL=http://localhost:5173
API_BASE_PATH=/digitalinvoice-server/api
TIMEZONE=Africa/Lagos

DB_HOST=localhost
DB_PORT=3306
DB_NAME=digitalinvoice_db
DB_USERNAME=root
DB_PASSWORD=

ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE=digitalinvoice_access
AUTH_REFRESH_COOKIE=digitalinvoice_refresh
AUTH_CSRF_COOKIE=digitalinvoice_csrf
# Allow Postman/frontend to send the CSRF double-submit token as Authorization: Bearer <csrf_token>.
AUTH_CSRF_BEARER_ENABLED=true

# Generate a long random secret before running: at least 64 characters.
JWT_SECRET=change-this-to-a-long-random-secret-of-at-least-sixty-four-characters-before-use
JWT_ISSUER=http://localhost/digitalinvoice-server/api
JWT_AUDIENCE=digitalinvoice-web
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=43200
# Authenticated users are signed out after 30 minutes without API activity or 12 hours total.
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
# Reduces session activity writes while preserving an accurate inactivity window.
SESSION_ACTIVITY_TOUCH_INTERVAL=60
CSRF_TOKEN_EXPIRES_IN=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_RATE_WINDOW_MINUTES=15

# Google Identity Services web client ID. The frontend receives the public client ID from GET /auth/config.
# Add http://localhost:5173 to the Google OAuth Web Client authorised JavaScript origins.
GOOGLE_CLIENT_ID=
GOOGLE_LOGIN_ENABLED=false

# Create recurring plans in the Paystack test dashboard, then store each plan code in the plans table.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PAYMENT_ENABLED=false
PAYSTACK_CALLBACK_URL=http://localhost:5173/subscription/verify

# Transactional email. SMTP works from localhost when valid credentials/network access are available.
# Use MAIL_DRIVER=smtp to send real registration, reset-password, invitation, demo and subscription emails.
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=no-reply@digitalinvoiceng.com
MAIL_FROM_NAME="DigitalInvoice Nigeria"
MAIL_REPLY_TO_ADDRESS=support@digitalinvoiceng.com
MAIL_REPLY_TO_NAME="DigitalInvoice Support"
MAIL_SUPPORT_EMAIL=support@digitalinvoiceng.com
MAIL_WEBSITE_URL=https://digitalinvoiceng.com
# Use publicly available DigitalInvoice image URLs so email clients can display your official logo.
MAIL_BRAND_LOGO_URL=https://digitalinvoiceng.com/assets/images/e-invoicing/logo-dark.png
MAIL_BRAND_ICON_URL=https://digitalinvoiceng.com/assets/images/e-invoicing/ico.png
# Configure for your chosen SMTP provider. Port 465 = smtps/implicit TLS; port 587 = starttls.
SMTP_HOST=
SMTP_PORT=465
SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=smtps
SMTP_TIMEOUT=30
# Keep true outside temporary local certificate diagnosis. Never disable peer verification in production.
SMTP_VERIFY_PEER=true
# Optional internal notification for demo leads.
DEMO_NOTIFICATION_EMAIL=
DEMO_NOTIFICATION_NAME="DigitalInvoice Sales"

# Team invitation lifecycle
TEAM_INVITATION_EXPIRES_IN_HOURS=168
